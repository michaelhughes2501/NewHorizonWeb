{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite: dev",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/new-horizon-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Chrome: client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/new-horizon-web"
    }
  ]
}
