{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite: dev",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/new-horizon-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Chrome: New Horizon",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/new-horizon-web/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full: Dev Server + Chrome",
      "configurations": ["Vite: dev", "Chrome: New Horizon"],
      "stopAll": true
    }
  ]
}
