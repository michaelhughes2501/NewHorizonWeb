VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: alternative publishable key (used by BACKEND_READY check in App.jsx)
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Comma-separated SHA-256 hex hashes of emails allowed to access /admin.
# We hash so plain-text admin emails don't leak into the client bundle.
# The email MUST be lowercased before hashing — AdminGuard lowercases the
# session email before comparing, so a mixed-case digest will never match.
# To generate a hash locally:
#   echo -n "you@example.com" | tr '[:upper:]' '[:lower:]' | shasum -a 256
# Empty = no admin access.
VITE_ADMIN_EMAILS=
