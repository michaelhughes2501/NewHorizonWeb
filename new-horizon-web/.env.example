# Browser-safe settings (inlined into the bundle by Vite).
# Neon Auth base URL for the New_Horizons project (Neon Console > Auth > Configuration).
VITE_NEON_AUTH_URL=
# Optional: API origin when the API is not served from the same site (default /api).
# VITE_API_BASE_URL=

# Comma-separated SHA-256 hex hashes of emails allowed to access /admin.
# We hash so plain-text admin emails don't leak into the client bundle.
# The email MUST be lowercased before hashing — AdminGuard lowercases the
# session email before comparing, so a mixed-case digest will never match.
# To generate a hash locally:
#   echo -n "you@example.com" | tr '[:upper:]' '[:lower:]' | shasum -a 256
# Empty = no admin access.
VITE_ADMIN_EMAILS=

# ── Integrations (Google OAuth) ─────────────────────────────────────────
# Public Google OAuth Web Application client id. Register this app's origin +
#   <origin>/integrations/callback
# as an authorized redirect URI in Google Cloud Console.
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Optional override; defaults to this app's own /api/integrations.
# VITE_INTEGRATIONS_FUNCTION_URL=
