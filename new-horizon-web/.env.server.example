# Server-only settings for New Horizon (read by server.js).
# Never expose these in browser code or any VITE_* variable.
# Copy to .env.server for `npm run dev:api`.

# Neon "New_Horizons" project. Pooled for queries, direct for live updates
# (LISTEN does not work through the pooler) and migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Neon Console > Auth > Configuration). Used to verify sign-ins.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Profile photos on Neon Object Storage (optional; uploads return 501 without these).
# `neon env pull` writes the AWS_* values once a bucket exists.
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AVATAR_BUCKET=avatars
# Public base URL for objects in the avatar bucket.
AVATAR_PUBLIC_BASE_URL=

# Google OAuth token exchange for /integrations (moved from the Supabase Edge Function).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email / notifications
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Optional tuning
# PORT=3000
# API_RATE_LIMIT=300
# TRUST_PROXY=1
APP_BASE_URL=
