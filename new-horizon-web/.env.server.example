# Server-side and CLI-only secrets for New Horizon.
# Never expose these in browser code or any VITE_* variable.

# Supabase CLI / management
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=your-project-ref

# Supabase server-side operations
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=your_database_password

# Email / notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@newhorizon.app
EMAIL_REPLY_TO=support@newhorizon.app

# Optional deployment/runtime values
APP_BASE_URL=https://newhorizon.app
SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# ── Integrations (Google OAuth) — Supabase Edge Function secrets ────────
# Set these in the Supabase project's Functions -> Secrets (they are read
# via Deno.env by supabase/functions/integrations/index.ts). NEVER prefix
# them with VITE_ — that would inline the client_secret into the SPA.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
